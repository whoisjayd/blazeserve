[Unit]
Description=BlazeServe HTTP file server
Documentation=https://github.com/whoisjayd/blazeserve
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blazeserve
Group=blazeserve
WorkingDirectory=/srv/blazeserve
ExecStart=/usr/local/bin/blaze serve /srv/blazeserve \
    --host 127.0.0.1 \
    --port 8000 \
    --trust-proxy 127.0.0.1/32 \
    --log-json
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=true
ReadWritePaths=/srv/blazeserve

LimitNOFILE=1048576
LimitNPROC=512

[Install]
WantedBy=multi-user.target
